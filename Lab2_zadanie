-- 1. Выбрать всех клиентов в возрасте от 18 до 30 лет, проживающих в Москве.

SELECT * FROM client 
WHERE AGE(CURRENT_DATE, date_of_birth) BETWEEN '18 years' AND '30 years'
  AND address LIKE '%Москва%';


-- 2. Выбрать всех клиентов, сделавших заказы в 2008 году.
SELECT DISTINCT c.*
FROM client c
JOIN orders o ON c.client_code = o.client_code
WHERE EXTRACT(YEAR FROM o.order_date) = 2008;

--3. Создать таблицу, содержащую данные 2 запроса с указанием контактных телефонов.
SELECT DISTINCT 
    c.client_code, 
    c.last_name, 
    c.first_name, 
    c.patronymic, 
	c.date_of_birth,
	c.representative_of_company,
    c.address,
	c.contact_phone
INTO clients_2008_orders
FROM client c
JOIN orders o ON c.client_code = o.client_code
WHERE EXTRACT(YEAR FROM o.order_date) = 2008;

--4. Добавить в созданную таблицу клиентов, у которых отсутсвует контактный телефон. 
INSERT INTO clients_2008_orders (
    client_code, 
    last_name, 
    first_name, 
    patronymic, 
    date_of_birth, 
    representative_of_company, 
    address, 
    contact_phone
)
SELECT c.client_code, c.last_name, c.first_name, c.patronymic, c.date_of_birth, c.representative_of_company, c.address, c.contact_phone
FROM client c
WHERE c.contact_phone IS NULL
AND NOT EXISTS (
SELECT 1 
FROM clients_2008_orders t
WHERE t.client_code = c.client_code
)
 
--5. В созданной таблице для всех клиентов, у которых номер телефона начинается на 8, 
заменить первую цифру на 7.
UPDATE clients_2008_orders 
SET contact_phone = '+7' || RIGHT(contact_phone, LENGTH(contact_phone) - 1)
WHERE contact_phone LIKE '8%';

--6. Удалить из созданной таблицы всех клиентов с фамилиями на буквы «А», «Б» и «В».

DELETE FROM clients_2008_orders 
WHERE last_name LIKE 'А%' 
   OR last_name LIKE 'Б%' 
   OR last_name LIKE 'В%';

--7. Посчитать средний срок сборки заказов для каждого клиента.
SELECT 
    c.client_code,
    c.last_name, 
    c.first_name, 
    AVG(o.assembly_deadline - o.order_date) AS avg_assembly_days
FROM client c
JOIN orders o ON c.client_code = o.client_code
GROUP BY c.client_code, c.last_name, c.first_name;
